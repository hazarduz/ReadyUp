<Application x:Class="ReadyUp.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ReadyUp.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared converters, available to every window/dialog/control without a local declaration. -->
            <conv:PathToImageSourceConverter x:Key="PathToImage"/>
            <conv:NullToBoolConverter x:Key="NullToBool"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:CountToVisibilityConverter x:Key="CountToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
