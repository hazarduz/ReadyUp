<Window x:Class="ReadyUp.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ReadyUp.App.Controls"
        xmlns:vm="clr-namespace:ReadyUp.App.ViewModels"
        d:DataContext="{d:DesignInstance vm:LibraryViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Style="{StaticResource AppWindowStyle}"
        Title="ReadyUp" Height="800" Width="1280" MinWidth="820" MinHeight="560">

    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="16,12">
            <DockPanel>
                <TextBlock Text="ReadyUp" Style="{StaticResource TitleTextStyle}" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,24,0"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Full Screen" Style="{StaticResource ToolbarButtonStyle}" Click="FullScreenButton_Click"/>
                    <Button Content="Settings" Style="{StaticResource ToolbarButtonStyle}" Click="SettingsButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Scan for Games" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ScanForGamesCommand}"/>
                    <Button Content="Add Game..." Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding AddGameManuallyCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Library grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <ItemsControl x:Name="GameGrid" ItemsSource="{Binding Games}"
                          KeyboardNavigation.DirectionalNavigation="Contained">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:GameTileControl Margin="8"
                                                   ChangeArtRequested="GameTile_ChangeArtRequested"
                                                   EditMetadataRequested="GameTile_EditMetadataRequested"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Text="No games yet — try &quot;Scan for Games&quot; or &quot;Add Game...&quot;"
                   Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Games.Count, Converter={StaticResource CountToVis}, ConverterParameter=Invert}"/>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="16,8">
            <DockPanel>
                <TextBlock Text="Scanning..." Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Right"
                           Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubtitleTextStyle}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
