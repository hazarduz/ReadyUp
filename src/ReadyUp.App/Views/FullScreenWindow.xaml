<Window x:Class="ReadyUp.App.Views.FullScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ReadyUp.App.Controls"
        xmlns:vm="clr-namespace:ReadyUp.App.ViewModels"
        d:DataContext="{d:DesignInstance vm:LibraryViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Style="{StaticResource AppWindowStyle}"
        Title="ReadyUp — Big Picture" WindowStyle="None" ResizeMode="NoResize" Background="Black">

    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <!-- Full-bleed background art for the focused game -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.55"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="#FF0A0B0F" Offset="0"/>
                    <GradientStop Color="#CC0A0B0F" Offset="0.4"/>
                    <GradientStop Color="#000A0B0F" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock Text="ReadyUp" Style="{StaticResource TitleTextStyle}" FontSize="32" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubtitleTextStyle}" DockPanel.Dock="Right"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </DockPanel>

            <TextBlock Grid.Row="1" Text="No games yet — press Start for the main menu, or add games from Windowed mode."
                       Style="{StaticResource SubtitleTextStyle}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Games.Count, Converter={StaticResource CountToVis}, ConverterParameter=Invert}"/>

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Height="380" VerticalAlignment="Bottom">
                <ItemsControl x:Name="GameShelf" ItemsSource="{Binding Games}"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:GameTileControl Margin="10" GotKeyboardFocus="GameTile_GotKeyboardFocus"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Gamepad-first game-options overlay (hold Y on a focused tile) -->
        <Grid x:Name="GameOptionsOverlayGrid" Background="#CC0A0B0F" Visibility="Collapsed">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Width="420" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="GameOptionsTitle" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>
                    <Button Content="Launch" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,0,8" Click="GameOptions_Launch_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Change Game Art" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,0,8" Click="GameOptions_ChangeArt_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Toggle Favorite" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,0,8" Click="GameOptions_ToggleFavorite_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Remove from Library" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,0,8" Click="GameOptions_Remove_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Close (B)" Style="{StaticResource ToolbarButtonStyle}" Click="GameOptions_Close_Click" HorizontalContentAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Start-button main menu -->
        <Grid x:Name="MainMenuOverlayGrid" Background="#CC0A0B0F" Visibility="Collapsed">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Width="380" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Main Menu" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>
                    <Button Content="Scan for Games" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,0,8" Command="{Binding ScanForGamesCommand}" HorizontalContentAlignment="Left"/>
                    <Button Content="Exit to Windowed Mode" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,0,8" Click="MainMenu_ExitToWindowed_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Exit ReadyUp" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,0,8" Click="MainMenu_ExitApp_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Close (B)" Style="{StaticResource ToolbarButtonStyle}" Click="MainMenu_Close_Click" HorizontalContentAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
