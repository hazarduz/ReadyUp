<Window x:Class="ReadyUp.App.Views.ChangeArtDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ReadyUp.Core.Models;assembly=ReadyUp.Core"
        xmlns:vm="clr-namespace:ReadyUp.App.ViewModels"
        d:DataContext="{d:DesignInstance vm:ChangeArtViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Style="{StaticResource AppWindowStyle}"
        Title="Change Game Art" Height="560" Width="760" WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Game.Title, StringFormat='Change Game Art — {0}'}" Style="{StaticResource TitleTextStyle}"/>

        <!-- Art-type tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <Button Content="Icon" Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding SelectArtTypeCommand}" CommandParameter="{x:Static core:ArtAssetType.Icon}"/>
            <Button Content="Banner" Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding SelectArtTypeCommand}" CommandParameter="{x:Static core:ArtAssetType.Banner}"/>
            <Button Content="Box Art" Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding SelectArtTypeCommand}" CommandParameter="{x:Static core:ArtAssetType.BoxArt}"/>
            <Button Content="Background" Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding SelectArtTypeCommand}" CommandParameter="{x:Static core:ArtAssetType.Background}"/>
        </StackPanel>

        <!-- Search results grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="6" Padding="0" BorderThickness="0" Background="Transparent"
                                Command="{Binding DataContext.ApplyCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Image Source="{Binding ThumbnailUrl, Converter={StaticResource PathToImage}}" Width="150" Stretch="Uniform"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource SubtitleTextStyle}" Margin="0,12,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="Searching..." Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Browse Local File..." Style="{StaticResource ToolbarButtonStyle}" Command="{Binding BrowseLocalFileCommand}"/>
            <Button Content="Search SteamGridDB" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SearchOnlineCommand}"/>
            <Button Content="Close" Style="{StaticResource ToolbarButtonStyle}" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
