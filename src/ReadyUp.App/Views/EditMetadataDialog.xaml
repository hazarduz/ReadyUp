<Window x:Class="ReadyUp.App.Views.EditMetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="Edit Metadata" Height="420" Width="480" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Edit Metadata" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="Title" Style="{StaticResource SubtitleTextStyle}"/>
        <TextBox x:Name="TitleBox" Grid.Row="2" Margin="0,4,0,12"/>

        <TextBlock Grid.Row="3" Text="Publisher / Developer" Style="{StaticResource SubtitleTextStyle}"/>
        <Grid Grid.Row="4" Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PublisherBox" Grid.Column="0"/>
            <TextBox x:Name="DeveloperBox" Grid.Column="2"/>
        </Grid>

        <TextBlock Grid.Row="5" Text="Description" Style="{StaticResource SubtitleTextStyle}"/>
        <TextBox x:Name="DescriptionBox" Grid.Row="7" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource ToolbarButtonStyle}" Click="CancelButton_Click"/>
            <Button Content="Save" Style="{StaticResource ToolbarButtonStyle}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
