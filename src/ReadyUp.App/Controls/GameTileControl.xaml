<UserControl x:Class="ReadyUp.App.Controls.GameTileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReadyUp.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:GameViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="220" Height="330" Focusable="False">

    <Button x:Name="RootButton"
            Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}"
            Cursor="Hand"
            KeyboardNavigation.DirectionalNavigation="None">
        <Button.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Launch" Click="LaunchMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Change Game Art..." Click="ChangeArtMenuItem_Click"/>
                <MenuItem Header="Edit Metadata..." Click="EditMetadataMenuItem_Click"/>
                <MenuItem Header="Toggle Favorite" Click="ToggleFavoriteMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Remove from Library" Click="RemoveMenuItem_Click"/>
            </ContextMenu>
        </Button.ContextMenu>
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Card" CornerRadius="10" Background="{StaticResource SurfaceBrush}" BorderThickness="3" BorderBrush="Transparent">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid ClipToBounds="True">
                            <Image Source="{Binding BoxArtPath, Converter={StaticResource PathToImage}, ConverterParameter=440}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding BoxArtPath, Converter={StaticResource NullToBool}}"/>
                            <Border Background="{StaticResource SurfaceRaisedBrush}"
                                    Visibility="{Binding BoxArtPath, Converter={StaticResource NullToBool}, ConverterParameter=Invert}">
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                           Margin="12" FontSize="16"/>
                            </Border>
                            <TextBlock Text="&#9733;" FontSize="20" Foreground="{StaticResource FavoriteBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource NullToBool}}"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="10,8" >
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PlaytimeDisplay}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        <Setter TargetName="Card" Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.04" ScaleY="1.04" CenterX="110" CenterY="165"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
